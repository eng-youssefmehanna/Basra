<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="main.java.view.Homecontroller"
      prefWidth="1280" prefHeight="720"  spacing="10" stylesheets="@../css/Home.css"> <!-- spacing for the hr separator line-->

    <VBox prefHeight="550" maxHeight="550" VBox.vgrow="NEVER" >

        <fx:include source="widgets/Header_Home.fxml" fx:id="Header_Home_Include"
             prefHeight="110" maxHeight="110"/>


        <fx:include source="widgets/Middle_Home.fxml" fx:id="Middle_Home_Include"
                 alignment="CENTER"   prefHeight="340" maxHeight="340"  />


    </VBox>

    <Region prefHeight="4" maxHeight="4" maxWidth="Infinity" VBox.vgrow="NEVER"
            style="-fx-background-color: #d4a843;">
        <VBox.margin>
            <Insets bottom="10" />
        </VBox.margin>
    </Region>

    <HBox prefHeight="120" maxHeight="195" VBox.vgrow="NEVER"  >
        <padding>
            <Insets left="25" top="10"/>
        </padding>
       <VBox spacing="30"> <!-- extra space for borders if needed in styling-->

        <fx:include source="widgets/Label1_Label2dynamic.fxml" fx:id="Label1_Label2dynamic_include1"
                    prefHeight="50"   maxWidth="Infinity" maxHeight="50"   />

        <fx:include source="widgets/Label1_Label2dynamic.fxml" fx:id="Label1_Label2dynamic_include2"
                    prefHeight="50"   maxWidth="Infinity" maxHeight="50" />
       </VBox>

    </HBox>
</VBox>