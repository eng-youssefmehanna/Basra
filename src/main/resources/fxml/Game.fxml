<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.java.view.Gamecontroller"
            prefWidth="1280" prefHeight="720"
            stylesheets="@../css/Game.css">

    <!-- TOP  Opponent Player 2 -->
    <top>
        <VBox fx:id="player2Block" alignment="CENTER" spacing="6"
              prefHeight="150" visible="false">
            <padding><Insets top="10"/></padding>
            <HBox alignment="CENTER" spacing="10">
                <ImageView fx:id="player2Avatar" fitWidth="40" fitHeight="40"/>
                <Label fx:id="player2Username" text="Player 2"/>
            </HBox>
            <HBox fx:id="player2Cards" alignment="CENTER" spacing="-25"/>
        </VBox>
    </top>

    <!-- LEFT  Opponent Player 3 -->
    <left>
        <VBox fx:id="player3Block" alignment="CENTER" spacing="6"
              prefWidth="150" visible="false">
            <padding><Insets left="10"/></padding>
            <ImageView fx:id="player3Avatar" fitWidth="40" fitHeight="40"/>
            <Label fx:id="player3Username" text="Player 3"/>
            <VBox fx:id="player3Cards" alignment="CENTER" spacing="-50"/>
        </VBox>
    </left>

    <!-- RIGHT Opponent Player 4 -->
    <right>
        <VBox fx:id="player4Block" alignment="CENTER" spacing="6"
              prefWidth="150" visible="false">
            <padding><Insets right="10"/></padding>
            <ImageView fx:id="player4Avatar" fitWidth="40" fitHeight="40"/>
            <Label fx:id="player4Username" text="Player 4"/>
            <VBox fx:id="player4Cards" alignment="CENTER" spacing="-50"/>
        </VBox>
    </right>

    <!-- CENTER : Floor + Deck + Turn info -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="20" bottom="20" left="10" right="10"/>
            </padding>

            <!-- Floor area -->
            <HBox fx:id="floorCards" alignment="CENTER" spacing="-15"
                  prefHeight="130" minHeight="130" minWidth="400"
                  style="-fx-border-color: #c9a84c; -fx-border-width: 1.5;
                         -fx-border-radius: 10; -fx-padding: 12;
                         -fx-background-color: rgba(0,0,0,0.15);
                         -fx-background-radius: 10;"/>

            <!-- Deck + turn + status  -->
            <HBox alignment="CENTER" spacing="50">
                <VBox alignment="CENTER" spacing="4">
                    <ImageView fx:id="deckPile" fitWidth="65" fitHeight="95"/>
                    <Label fx:id="deckCount" text="52"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Current turn:"/>
                    <Label fx:id="currentTurnLabel" text="—"
                           style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                </VBox>
                <Label fx:id="statusLabel" text=""
                       style="-fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </center>

    <!-- BOTTOM Local Player face-up cards -->
    <bottom>
        <VBox fx:id="player1Block" alignment="CENTER" spacing="8"
              prefHeight="170">
            <padding><Insets bottom="12"/></padding>
            <HBox fx:id="player1Cards" alignment="CENTER" spacing="-25"/>
            <HBox alignment="CENTER" spacing="10">
                <ImageView fx:id="player1Avatar" fitWidth="48" fitHeight="48"/>
                <Label fx:id="player1Username" text="You"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>