<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.view.Joincontroller"
      prefWidth="340" prefHeight="200"
      maxWidth="340" maxHeight="200"
      spacing="20"  alignment="CENTER"  stylesheets="@../css/Join.css" >
    <padding>
        <Insets top="10"/>
    </padding>

    <TextField fx:id="Code_enter" promptText="Enter game code" prefWidth="200"  maxWidth="200"  prefHeight="25"
               style="-fx-font-size: 16px;"/>

    <Button fx:id="Join_game"  text="Join game"    style="-fx-font-size: 20px;"  prefWidth="150" prefHeight="35"
            maxWidth="150" maxHeight="35"
            onAction="#handleJoinGame"/>

    <Label fx:id="JoinLabel" text="Joining..."
           style="-fx-text-fill: #7a6a4a; -fx-font-size: 14px;" visible="false"/>

    <Label fx:id="errorNotFound" text="Code not found."
           style="-fx-text-fill: red; -fx-font-size: 14px;" visible="false"/>

    <Label fx:id="errorLobbyFull" text="Lobby is full."
           style="-fx-text-fill: red; -fx-font-size: 14px;" visible="false"/>


</VBox>


